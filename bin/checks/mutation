#!/usr/bin/env bash
# Selective mutation testing of critical pure logic (Foundation 0 §47).
# Classes are selected with mutates() in their unit tests; add it as units, quantities,
# entitlements and permission predicates arrive. Needs a PHP coverage driver (pcov or xdebug).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

vendor/bin/pest --colors=never --mutate --covered-only --min=80
