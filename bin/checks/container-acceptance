#!/usr/bin/env bash
# Deployment acceptance tests against the built image (MVP deploy/boot requirements).
#   ./bin/verify container-acceptance            builds nothing; expects the image in IMAGE (default ricette:ci)
#
# 1. SQLite: a fresh volume reaches the current schema with no manual step, and both the
#    schema and application data survive a container restart.
# 1b. Application key: created and stored on first start when none is supplied, and kept across restarts.
# 2. PostgreSQL: the application starts before the database, retries until it is up,
#    and then migrates.
# 3. Reverse proxy: forwarded headers are ignored unless TRUSTED_PROXIES trusts the peer.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

IMAGE=${IMAGE:-ricette:ci}
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
suffix=$$
containers=()
volumes=()
networks=()

cleanup() {
  for c in "${containers[@]:-}"; do [ -n "$c" ] && docker rm -f "$c" >/dev/null 2>&1 || true; done
  for v in "${volumes[@]:-}"; do [ -n "$v" ] && docker volume rm -f "$v" >/dev/null 2>&1 || true; done
  for n in "${networks[@]:-}"; do [ -n "$n" ] && docker network rm "$n" >/dev/null 2>&1 || true; done
}
trap cleanup EXIT

fail() {
  echo "FAILED: $*" >&2
  for c in "${containers[@]:-}"; do
    [ -n "$c" ] && { echo "--- logs: $c" >&2; docker logs "$c" 2>&1 | tail -40 >&2 || true; }
  done
  exit 1
}

host_port() { docker port "$1" 8080/tcp | head -1 | sed 's/.*://'; }

wait_for_up() { # wait_for_up <container> <seconds>
  local port
  port=$(host_port "$1")
  for _ in $(seq 1 "$2"); do
    if curl -fsS --max-time 5 "http://127.0.0.1:$port/up" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  docker logs "$1" >&2 || true
  return 1
}

migrations_pending() { docker exec "$1" php artisan migrate:status --pending 2>&1 || true; }

echo "== 1. SQLite: fresh volume migrates at boot and survives a restart"
vol=ricette-accept-data-$suffix
volumes+=("$vol")
docker volume create "$vol" >/dev/null
c=ricette-accept-sqlite-$suffix
containers+=("$c")
docker run -d --name "$c" -p 127.0.0.1::8080 -e APP_KEY="$APP_KEY" -v "$vol:/data" "$IMAGE" >/dev/null
wait_for_up "$c" 60 || fail "SQLite container did not serve /up"
out=$(migrations_pending "$c")
echo "$out" | grep -qi "no pending migrations" || fail "migrations pending after boot: $out"
ran_before=$(docker exec "$c" php artisan migrate:status 2>&1 | grep -c "Ran" || true)
[ "$ran_before" -gt 0 ] || fail "no migrations were applied"
# Application state, not just the schema, must survive a restart (persistence across restart, #68).
docker exec -i "$c" php <<'PHP' || fail "could not write test data into the SQLite volume"
<?php
$pdo = new PDO('sqlite:/data/database.sqlite');
$pdo->exec("insert into households (name, created_at, updated_at) values ('persistence-check', datetime('now'), datetime('now'))");
PHP
docker restart "$c" >/dev/null
wait_for_up "$c" 60 || fail "SQLite container did not serve /up after restart"
ran_after=$(docker exec "$c" php artisan migrate:status 2>&1 | grep -c "Ran" || true)
kept=$(docker exec -i "$c" php <<'PHP'
<?php
$pdo = new PDO('sqlite:/data/database.sqlite');
echo $pdo->query("select count(*) from households where name = 'persistence-check'")->fetchColumn();
PHP
)
[ "$kept" = "1" ] || fail "application data did not survive the restart (found: $kept)"
[ "$ran_before" = "$ran_after" ] || fail "schema changed across restart ($ran_before -> $ran_after)"

echo "== 1b. Application key: created on first start, kept across a restart, a supplied key is not stored"
kvol=ricette-accept-key-$suffix
volumes+=("$kvol")
docker volume create "$kvol" >/dev/null
k=ricette-accept-key-$suffix
containers+=("$k")
docker run -d --name "$k" -p 127.0.0.1::8080 -v "$kvol:/data" "$IMAGE" >/dev/null
wait_for_up "$k" 60 || fail "container without APP_KEY did not serve /up"
key_first=$(docker exec "$k" cat /data/app.key)
case "$key_first" in base64:?*) ;; *) fail "no application key was created in /data/app.key" ;; esac
[ "$(docker exec "$k" stat -c %a /data/app.key)" = 600 ] || fail "the key file is not private to its owner"
docker restart "$k" >/dev/null
wait_for_up "$k" 60 || fail "container did not serve /up after restart"
[ "$(docker exec "$k" cat /data/app.key)" = "$key_first" ] || fail "the application key changed across a restart"
supplied=ricette-accept-supplied-$suffix
containers+=("$supplied")
svol=ricette-accept-supplied-$suffix
volumes+=("$svol")
docker volume create "$svol" >/dev/null
docker run -d --name "$supplied" -p 127.0.0.1::8080 -e APP_KEY="$APP_KEY" -v "$svol:/data" "$IMAGE" >/dev/null
wait_for_up "$supplied" 60 || fail "container with a supplied APP_KEY did not serve /up"
docker exec "$supplied" test ! -e /data/app.key || fail "a supplied key was also written to the volume"

echo "== 2. PostgreSQL: the application starts first, waits, then migrates"
net=ricette-accept-net-$suffix
networks+=("$net")
docker network create "$net" >/dev/null
app=ricette-accept-pg-app-$suffix
db=ricette-accept-pg-db-$suffix
containers+=("$app" "$db")
docker run -d --name "$app" --network "$net" -p 127.0.0.1::8080 \
  -e APP_KEY="$APP_KEY" -e DB_CONNECTION=pgsql -e DB_HOST="$db" -e DB_PORT=5432 -e DB_DATABASE=ricette \
  -e DB_USERNAME=ricette -e DB_PASSWORD=ricette -e DB_WAIT_TIMEOUT=120 "$IMAGE" >/dev/null
sleep 8
port=$(host_port "$app")
if curl -fsS --max-time 5 "http://127.0.0.1:$port/up" >/dev/null 2>&1; then fail "application served before the database existed"; fi
docker run -d --name "$db" --network "$net" \
  -e POSTGRES_USER=ricette -e POSTGRES_PASSWORD=ricette -e POSTGRES_DB=ricette postgres:17 >/dev/null
wait_for_up "$app" 120 || fail "application did not start after the database came up"
# The backoff itself is unit-tested. Here the proof is behavioral: the application waited, stayed down while the
# database was absent, and came up on its own afterwards. A retry line in the log is not required because the
# first connection attempt can block on name resolution until the database container exists.
out=$(migrations_pending "$app")
echo "$out" | grep -qi "no pending migrations" || fail "migrations pending after boot: $out"

echo "== 3. Reverse proxy: forwarded headers need a trusted peer"
fetch() { curl -fsS -H 'X-Forwarded-Proto: https' -H 'X-Forwarded-Host: ricette.example' "http://127.0.0.1:$1/"; }
plain=ricette-accept-proxy-none-$suffix
trusted=ricette-accept-proxy-trusted-$suffix
containers+=("$plain" "$trusted")
docker run -d --name "$plain" -p 127.0.0.1::8080 -e APP_KEY="$APP_KEY" "$IMAGE" >/dev/null
docker run -d --name "$trusted" -p 127.0.0.1::8080 -e APP_KEY="$APP_KEY" -e TRUSTED_PROXIES='*' "$IMAGE" >/dev/null
wait_for_up "$plain" 60 || fail "container without trusted proxies did not start"
wait_for_up "$trusted" 60 || fail "container with trusted proxies did not start"
fetch "$(host_port "$plain")" | grep -q 'https://ricette.example' && fail "forwarded headers were honored with no trusted proxy"
fetch "$(host_port "$trusted")" | grep -q 'https://ricette.example/build/' || fail "forwarded headers were not honored from a trusted proxy"

echo "boot acceptance: OK"
