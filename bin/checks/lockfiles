#!/usr/bin/env bash
# Lockfiles are mandatory and must match their manifests (Foundation 0 §34,
# docs/development/dependencies.md).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
# shellcheck source=bin/lib.sh
source bin/lib.sh

tracked() {
  git ls-files --error-unmatch "$1" >/dev/null 2>&1 || {
    echo "lockfile is not committed: $1" >&2
    return 1
  }
}

pnpm_lock_current() {
  require_tool pnpm "https://pnpm.io (ADR-0020)" && pnpm install --frozen-lockfile --lockfile-only >/dev/null
}

step composer.lock-committed tracked composer.lock
step pnpm-lock-committed tracked pnpm-lock.yaml
step no-other-js-lockfiles bash -c '! git ls-files | grep -E "(^|/)(package-lock\.json|yarn\.lock|bun\.lockb?)$"'
step composer-lock-current composer validate --strict --no-check-publish
step pnpm-lock-current pnpm_lock_current
steps_result
