#!/usr/bin/env bash
# PHP style and static analysis (Foundation 0 §30, §33): Composer validation,
# Laravel Pint, PHPStan/Larastan at level 10.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
# shellcheck source=bin/lib.sh
source bin/lib.sh

require_tool composer "https://getcomposer.org"
step composer-validate composer validate --strict --no-check-publish
step pint vendor/bin/pint --test
step phpstan vendor/bin/phpstan analyse --memory-limit=1G --no-progress
steps_result
