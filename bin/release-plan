#!/usr/bin/env bash
# Decides what the release workflow should publish. Pure git logic: no network, no registry.
#
#   bin/release-plan release      weekly: is there anything new since the last version tag, and what is the next version?
#   bin/release-plan nightly      daily: has main changed since the last nightly image?
#   bin/release-plan context-changed <base>   does anything that could change the image differ from <base>? (prints relevant=true|false)
#   bin/release-plan tag vX.Y.Z  the build entry point: what to publish for an existing tag (used for the weekly tag and for re-runs)
#   bin/release-plan notes [from-tag]   release notes (markdown) from the same reading of the history that picks the version
#
# Prints KEY=VALUE lines (skip, reason, version, tags, sha, migrations), which the workflow appends to $GITHUB_OUTPUT.
#
# Inputs (environment):
#   LAST_NIGHTLY_SHA   commit the current 'nightly' image was built from (empty if none exists yet)
#   TAKEN_VERSION_TAGS newline-separated X.Y.Z tags that already exist in the registry (a release refuses to reuse one)
#   REBUILD_REASON     (release) non-empty when the base image changed: ship the same commit again as a patch release
#   BASE_IMAGE_NOTE    (notes) one line about a changed base image and the fixes it brings, written by the workflow
#   IMAGE_NAME, IMAGE_DIGEST   (notes) print the exact-image pin line
#   MAIN_REF           (tag) the branch a tagged commit must be reachable from (default: origin/main)
#
# Rules (docs/development/versioning.md, ADR-0029):
#   * A release is cut only if commits have landed since the last v* tag AND at least one changed file is inside the
#     Docker build context (not excluded by .dockerignore). One list, no second copy to keep in step.
#   * Before 1.0: a breaking change or a feature bumps the minor version, anything else bumps the patch.
#     From 1.0: breaking bumps major, a feature bumps minor, anything else bumps patch.
#   * Tags on a release: X.Y.Z, X.Y, X (from 1.0), latest, sha-<short>.
#   * Tags on a nightly: nightly (moves) and sha-<short>. Dated pin tags are deferred; the image digest is the pin.
#   * A base-image rebuild with no new commits is a patch release of the same commit (REBUILD_REASON), without sha-<short>.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

kind=${1:-}
head_sha=$(git rev-parse HEAD)
short=${head_sha:0:7}

out() { printf '%s=%s\n' "$1" "$2"; }
skip() {
  out skip true
  out reason "$1"
  exit 0
}

# What counts as "the image could change": any changed file that is inside the Docker build context, i.e. is not
# excluded by .dockerignore. There is one list, and it is .dockerignore. Only the syntax this repo uses is understood
# (plain names, directories, single-segment * and ? patterns, ! re-inclusion); anything else in .dockerignore
# (for example **) makes every change count, which only ever costs an extra build, never a missed one.
# EXTRA_RELEVANT is an optional regex of extra paths that should always count (used by CI to test its own workflow).
context_changed() { # context_changed <base>: succeeds when a file changed since <base> is inside the build context
  git diff --name-only "$1" HEAD | EXTRA_RELEVANT=${EXTRA_RELEVANT:-} DOCKERIGNORE="$(git show HEAD:.dockerignore 2>/dev/null || true)" python3 -c '
import fnmatch, os, re, sys

rules, unsupported = [], False
for raw in os.environ["DOCKERIGNORE"].splitlines():
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    negate = line.startswith("!")
    pat = line[1:] if negate else line
    pat = pat.strip("/")
    if "**" in pat or "\\" in pat:
        unsupported = True
    rules.append((negate, pat.split("/")))

def ignored(path):
    parts = path.split("/")
    hit = False
    for negate, pparts in rules:
        # a pattern excludes a path when it matches the path itself or any parent directory of it
        for k in range(1, len(parts) + 1):
            if len(pparts) == k and all(fnmatch.fnmatchcase(parts[i], pparts[i]) for i in range(k)):
                hit = not negate
                break
    return hit

extra = re.compile(os.environ["EXTRA_RELEVANT"]) if os.environ["EXTRA_RELEVANT"] else None
files = [l.strip() for l in sys.stdin if l.strip()]
if unsupported and files:
    sys.stderr.write("release-plan: .dockerignore uses syntax this script does not read; treating every change as relevant\n")
    sys.exit(0)
for f in files:
    if f in ("Dockerfile", ".dockerignore") or (extra and extra.search(f)) or not ignored(f):
        sys.exit(0)
sys.exit(1)
'
}
only_skippable() { # only_skippable <base>: true when nothing that could change the image changed since <base>
  ! context_changed "$1"
}

case "$kind" in
release)
  last=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' --merged HEAD | sort -V | tail -1)
  quiet=''
  rebuild=false
  if [ -n "$last" ]; then
    range="$last..HEAD"
    [ "$(git rev-list --count "$range")" -gt 0 ] || quiet="no commits since $last"
    [ -n "$quiet" ] || { only_skippable "$last" && quiet="only documentation, tests or editor settings changed since $last"; }
    if [ -n "$quiet" ]; then
      # Nothing of ours changed. A new base image is still a reason to ship: the same commit, rebuilt, as a patch release.
      [ -n "${REBUILD_REASON:-}" ] || skip "$quiet"
      rebuild=true
    fi
    ver=${last#v}
    IFS=. read -r major minor patch <<<"$ver"
  else
    range=HEAD
    major=0 minor=0 patch=0
  fi

  # Dependabot bodies quote upstream changelogs (which can contain "BREAKING CHANGE"), so a bot's commit can only
  # count through its subject line. A human commit counts through its subject or a "BREAKING CHANGE:" footer.
  breaking=0 feature=0
  while read -r commit; do
    email=$(git log -1 --format=%ae "$commit")
    subject=$(git log -1 --format=%s "$commit")
    grep -Eq '^[a-z]+(\([^)]*\))?!:' <<<"$subject" && breaking=1
    grep -Eq '^feat(\([^)]*\))?!?:' <<<"$subject" && feature=1
    case "$email" in
    *dependabot*) ;;
    *) git log -1 --format=%b "$commit" | grep -Eq '^BREAKING[ -]CHANGE: ' && breaking=1 ;;
    esac
  done < <(git rev-list "$range")

  if [ -z "$last" ]; then
    major=0 minor=1 patch=0
  elif [ "$rebuild" = true ]; then
    patch=$((patch + 1))
  elif [ "$major" -eq 0 ]; then
    if [ $breaking -eq 1 ] || [ $feature -eq 1 ]; then minor=$((minor + 1)) patch=0; else patch=$((patch + 1)); fi
  elif [ $breaking -eq 1 ]; then
    major=$((major + 1)) minor=0 patch=0
  elif [ $feature -eq 1 ]; then
    minor=$((minor + 1)) patch=0
  else
    patch=$((patch + 1))
  fi
  version="$major.$minor.$patch"
  if grep -qxF "$version" <<<"${TAKEN_VERSION_TAGS:-}"; then
    echo "version $version is already published in the registry but has no matching git tag; refusing to overwrite it" >&2
    exit 1
  fi
  migrations=false
  if [ -n "$last" ] && git diff --name-only "$last" HEAD | grep -q '^database/migrations/'; then migrations=true; fi
  tags="$version,$major.$minor"
  [ "$major" -ge 1 ] && tags="$tags,$major"
  tags="$tags,latest"
  # sha-<short> means "built from this commit" and must stay immutable, so a rebuild of an old commit does not take it
  [ "$rebuild" = true ] || tags="$tags,sha-$short"
  out skip false
  out kind release
  out rebuild "$rebuild"
  out version "$version"
  out git_tag "v$version"
  out previous "${last:-none}"
  out migrations "$migrations"
  out tags "$tags"
  out sha "$head_sha"
  ;;
nightly)
  last_sha=${LAST_NIGHTLY_SHA:-}
  if [ -n "$last_sha" ]; then
    [ "$last_sha" != "$head_sha" ] || skip "main has not changed since the last nightly ($short)"
    if git cat-file -e "$last_sha^{commit}" 2>/dev/null; then
      only_skippable "$last_sha" && skip "only documentation, tests or editor settings changed since the last nightly"
    fi
  fi
  out skip false
  out kind nightly
  out version "nightly-$short"
  out tags "nightly,sha-$short"
  out sha "$head_sha"
  ;;
context-changed)
  base=${2:?usage: bin/release-plan context-changed <base>}
  if context_changed "$base"; then out relevant true; else out relevant false; fi
  ;;
tag)
  # The build entry point. It never looks at "what is new": the tag decides everything, so a re-run of a failed
  # publish rebuilds exactly that tag's commit. Two guards:
  #   * the tagged commit must be on main, so a tag on an unreviewed branch cannot publish a production image;
  #   * the moving tags (X.Y, X, latest) only move when this tag is the highest version in that series, so re-running
  #     an old release can never move users backwards.
  tag=${2:-}
  [[ $tag =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || { echo "usage: bin/release-plan tag vX.Y.Z" >&2; exit 2; }
  tmajor=${BASH_REMATCH[1]} tminor=${BASH_REMATCH[2]}
  version=${tag#v}
  sha=$(git rev-parse "$tag^{commit}" 2>/dev/null) || { echo "tag $tag does not exist" >&2; exit 1; }
  main_ref=${MAIN_REF:-origin/main}
  git merge-base --is-ancestor "$sha" "$main_ref" 2>/dev/null || {
    echo "$tag points at ${sha:0:7}, which is not on $main_ref; refusing to publish it" >&2
    exit 1
  }
  all=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' | sort -V)
  highest() { # highest <prefix regex>: the highest tag matching the prefix
    grep -E "$1" <<<"$all" | tail -1
  }
  tags="$version"
  [ "$(highest "^v$tmajor\\.$tminor\\.")" = "$tag" ] && tags="$tags,$tmajor.$tminor"
  if [ "$tmajor" -ge 1 ] && [ "$(highest "^v$tmajor\\.")" = "$tag" ]; then tags="$tags,$tmajor"; fi
  [ "$(highest '^v')" = "$tag" ] && tags="$tags,latest"
  # A commit with more than one version tag was rebuilt; sha-<short> must keep meaning one exact build.
  [ "$(git tag --points-at "$sha" --list 'v[0-9]*' | wc -l)" -le 1 ] && tags="$tags,sha-${sha:0:7}"
  out skip false
  out kind release
  out version "$version"
  out git_tag "$tag"
  out tags "$tags"
  out sha "$sha"
  ;;
notes)
  from=${2:-$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)}
  range=${from:+$from..}HEAD
  breaking_list='' feature_list='' fix_list='' bot_count=0
  while read -r commit; do
    email=$(git log -1 --format=%ae "$commit")
    subject=$(git log -1 --format=%s "$commit")
    sh=${commit:0:7}
    case "$email" in
    *dependabot*)
      bot_count=$((bot_count + 1))
      continue
      ;;
    esac
    if [[ $subject =~ ^([a-z]+)(\([^\)]*\))?(!)?:\ (.+)$ ]]; then
      type=${BASH_REMATCH[1]} bang=${BASH_REMATCH[3]} text=${BASH_REMATCH[4]}
    else
      continue # merge commits and anything that is not a conventional commit
    fi
    footer=$(git log -1 --format=%b "$commit" | sed -n 's/^BREAKING[ -]CHANGE: //p' | head -1)
    if [ -n "$bang" ] || [ -n "$footer" ]; then
      instruction=${footer:-"(the author gave no upgrade instructions; ask before upgrading)"}
      breaking_list+="- **$text** ($sh)"$'\n'"  $instruction"$'\n'
    elif [ "$type" = feat ]; then
      feature_list+="- $text ($sh)"$'\n'
    elif [ "$type" = fix ] || [ "$type" = perf ]; then
      fix_list+="- $text ($sh)"$'\n'
    fi
  done < <(git rev-list "$range")

  [ -z "$breaking_list" ] || printf '## Breaking changes\n\n%s\n' "$breaking_list"
  [ -z "$feature_list" ] || printf '## Features\n\n%s\n' "$feature_list"
  [ -z "$fix_list" ] || printf '## Fixes\n\n%s\n' "$fix_list"
  if [ -z "$breaking_list$feature_list$fix_list" ]; then printf 'No user-visible changes in this release.\n\n'; fi

  upgrading=''
  if [ -n "$from" ]; then
    migs=$(git diff --name-only --diff-filter=AM "$from" HEAD -- database/migrations | wc -l)
    [ "$migs" -eq 0 ] || upgrading+="- **This release changes the database** ($migs new or changed migration files). It migrates on start. Back up your data volume first."$'\n'
    added=$(git diff "$from" HEAD -- .env.example | sed -n 's/^+#\? \?\([A-Z][A-Z0-9_]*\)=.*/\1/p' | sort -u | paste -sd, - | sed 's/,/, /g')
    removed=$(git diff "$from" HEAD -- .env.example | sed -n 's/^-#\? \?\([A-Z][A-Z0-9_]*\)=.*/\1/p' | sort -u | paste -sd, - | sed 's/,/, /g')
    [ -z "$added" ] || upgrading+="- New settings in .env.example: $added."$'\n'
    [ -z "$removed" ] || upgrading+="- Settings removed from .env.example: $removed."$'\n'
  fi
  [ -z "${BASE_IMAGE_NOTE:-}" ] || upgrading+="- $BASE_IMAGE_NOTE"$'\n'
  [ "$bot_count" -eq 0 ] || upgrading+="- $bot_count dependency update(s) are included; see the pull requests labeled dependencies."$'\n'
  printf '## Upgrading\n\n%s\n' "${upgrading:-No action needed.$'\n'}"
  if [ -n "${IMAGE_NAME:-}" ] && [ -n "${IMAGE_DIGEST:-}" ]; then
    printf '## This exact image\n\n```\ndocker pull %s@%s\n```\n' "$IMAGE_NAME" "$IMAGE_DIGEST"
  fi
  ;;
*)
  echo "usage: bin/release-plan release|nightly|tag|notes|context-changed" >&2
  exit 2
  ;;
esac
