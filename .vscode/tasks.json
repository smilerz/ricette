{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ricette: start dev servers",
      "type": "shell",
      "command": "./bin/dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dev:",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Ricette: start dev servers with demo data",
      "type": "shell",
      "command": "./bin/dev --seed",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dev:",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
