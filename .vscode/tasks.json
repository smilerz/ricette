{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ricette: start dev servers",
      "type": "shell",
      "command": "./bin/dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dev:",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Ricette: start dev servers with demo data",
      "type": "shell",
      "command": "./bin/dev --seed",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^dev:",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Ricette: set up this machine (./bin/setup)",
      "type": "shell",
      "command": "./bin/setup",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: check tools only (./bin/setup --check)",
      "type": "shell",
      "command": "./bin/setup --check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: test PHP (Pest)",
      "type": "shell",
      "command": "vendor/bin/pest",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Ricette: test frontend (Vitest)",
      "type": "shell",
      "command": "pnpm run test",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: test end to end (Playwright)",
      "type": "shell",
      "command": "pnpm run e2e",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: format everything (./bin/format)",
      "type": "shell",
      "command": "./bin/format",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: run every CI check (./bin/verify)",
      "type": "shell",
      "command": "./bin/verify",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Ricette: check before pushing (fast: lint, php-static, php-test, frontend)",
      "type": "shell",
      "command": "./bin/verify lint php-static php-test frontend",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
