{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node",
      "@testing-library/jest-dom"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.svelte",
    "scripts/**/*.mjs",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "eslint.config.js",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "svelte.config.js"
  ]
}
